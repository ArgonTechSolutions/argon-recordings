FROM node@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python@sha256:86adf8dbadc3d6e82ee5dd2c74bec2e1c2467cdad47886280501df722372d2e1
ENV PYTHONPATH=/app TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 RECORDINGS_DATA=/data RECORDINGS_STATIC=/app/static
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements-inference.lock backend/requirements.txt ./
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements-inference.lock && pip install --no-cache-dir -r requirements.txt && pip check
COPY backend/argon_recordings ./argon_recordings
COPY scripts/prepare_embeddings.py scripts/prepare_turbo.py scripts/check_media_runtime.py scripts/evaluate_embeddings.py ./scripts/
COPY --from=web /web/dist ./static
RUN mkdir -p /data /work && chown 10001:10001 /data /work
USER 10001:10001
CMD ["python", "-m", "argon_recordings.isolated", "api"]
