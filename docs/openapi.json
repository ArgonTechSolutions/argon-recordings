  "components": {
    "schemas": {
      "Artifact": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "audio",
              "frame"
            ],
            "title": "Kind"
          },
          "time": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind",
          "url"
        ],
        "title": "Artifact"
      },
      "ArtifactInput": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(audio\\.wav|frame-[0-9]{4}\\.jpg)$",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "audio",
              "frame"
            ],
            "title": "Kind"
          },
          "time": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "title": "ArtifactInput"
      },
      "ClaimRequest": {
        "properties": {
          "worker": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Worker"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "worker"
        ],
        "title": "ClaimRequest"
      },
      "Completion": {
        "properties": {
          "duration": {
            "type": "number",
            "maximum": 300.0,
            "exclusiveMinimum": 0.0,
            "title": "Duration"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Segments"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactInput"
            },
            "type": "array",
            "maxItems": 25,
            "title": "Artifacts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "duration",
          "segments",
          "artifacts"
        ],
        "title": "Completion"
      },
      "Failure": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "Failure"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Heartbeat": {
        "properties": {
          "progress": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress"
          },
          "stage": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Stage"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "progress",
          "stage"
        ],
        "title": "Heartbeat"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "progress": {
            "type": "number",
            "title": "Progress"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "state",
          "progress",
          "stage"
        ],
        "title": "Job"
      },
      "Project": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created": {
            "type": "number",
            "title": "Created"
          },
          "recording_count": {
            "type": "integer",
            "title": "Recording Count",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "created"
        ],
        "title": "Project"
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ProjectCreate"
      },
      "Recording": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created": {
            "type": "number",
            "title": "Created"
          },
          "job": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Job"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifacts": {
            "items": {
